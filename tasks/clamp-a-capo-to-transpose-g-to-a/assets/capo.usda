#usda 1.0
(
    defaultPrim = "Capo"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Capo"
{
    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 0.9000
        float physics:dynamicFriction = 0.8000
        float physics:restitution = 0
    }

    def Scope "Looks"
    {
        def Material "anodised"
        {
            token outputs:surface.connect = </Capo/Looks/anodised/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.35
                color3f inputs:diffuseColor = (0.62, 0.03, 0.03)
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }
        def Material "rubber"
        {
            token outputs:surface.connect = </Capo/Looks/rubber/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.02, 0.02, 0.022)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
        def Material "steel"
        {
            token outputs:surface.connect = </Capo/Looks/steel/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.9
                color3f inputs:diffuseColor = (0.8, 0.8, 0.81)
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }
    }

    def Xform "frame" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI", "PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    )
    {
        double3 xformOp:translate = (0.000000, 0.000000, 0.000000)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float physics:mass = 0.03000
        point3f physics:centerOfMass = (-0.013000, 0.000000, -0.002600)
        float3 physics:diagonalInertia = (9.360e-06, 1.989e-05, 1.125e-05)
        float physxRigidBody:maxDepenetrationVelocity = 1
        float physxRigidBody:sleepThreshold = 0
        float physxRigidBody:stabilizationThreshold = 0
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 4
        float physxArticulation:sleepThreshold = 0
        float physxArticulation:stabilizationThreshold = 0

        def Cube "col_pad" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Capo/PhysicsMaterial>
            uniform token purpose = "guide"
            double size = 1
            float physxCollision:contactOffset = 0.002
            float physxCollision:restOffset = 0
            double3 xformOp:translate = (0.000000, 0.000000, 0.002000)
            float3 xformOp:scale = (0.054000, 0.012000, 0.004000)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "col_bar" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Capo/PhysicsMaterial>
            uniform token purpose = "guide"
            double size = 1
            float physxCollision:contactOffset = 0.002
            float physxCollision:restOffset = 0
            double3 xformOp:translate = (-0.003500, 0.000000, 0.008000)
            float3 xformOp:scale = (0.066000, 0.012000, 0.008000)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
