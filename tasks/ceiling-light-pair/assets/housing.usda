#usda 1.0
(
    defaultPrim = "housing"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "housing" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, -0.018)
    float3 physics:diagonalInertia = (0.4583526, 0.02510604, 0.48159322)
    float physics:mass = 3.7

    def "Looks"
    {
        def Material "white"
        {
            token outputs:surface.connect = </housing/Looks/white/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.93, 0.91)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "inner"
        {
            token outputs:surface.connect = </housing/Looks/inner/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.83, 0.82)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "board"
        {
            token outputs:surface.connect = </housing/Looks/board/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.9, 0.86)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "led"
        {
            token outputs:surface.connect = </housing/Looks/led/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.98, 0.97, 0.85)
                float inputs:metallic = 0
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "trim"
        {
            token outputs:surface.connect = </housing/Looks/trim/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "channel"
        {
            token outputs:surface.connect = </housing/Looks/channel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.76, 0.75)
                float inputs:metallic = 0.4
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "rubber_phys" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1
            float physics:restitution = 0
            float physics:staticFriction = 1.1
        }
    }

    def Cube "back_0" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </housing/Looks/white>
        custom float physxCollision:contactOffset = 0.0005
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.28, 0.084, 0.0015)
        double3 xformOp:translate = (0, -0.567, -0.00075)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
