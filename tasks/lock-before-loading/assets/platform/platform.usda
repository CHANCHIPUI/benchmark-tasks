#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "hinged_platform"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Xform "hinged_platform" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physics"
    }
    append variantSets = "Physics"
)
{
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
}

over "Flattened_Prototype_109"
{
    def Shader "PreviewSurface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </Flattened_Prototype_109.inputs:diffuseColor>
        float inputs:metallic.connect = </Flattened_Prototype_109.inputs:metallic>
        float inputs:opacity.connect = </Flattened_Prototype_109.inputs:opacity>
        float inputs:roughness.connect = </Flattened_Prototype_109.inputs:roughness>
        token outputs:displacement
        token outputs:surface
    }
}

