    over "Physics"
    {
        def PhysicsRevoluteJoint "hinge" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.00052359875
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 0
            uniform token drive:angular:physics:type = "force"
            float newton:damping = 0.00052359875
            float newton:velocityLimit = 1145.9156
            uniform token physics:axis = "X"
            custom rel physics:body0
            append rel physics:body0 = </hinged_platform/Geometry/stand>
            custom rel physics:body1
            append rel physics:body1 = </hinged_platform/Geometry/stand/platform>
            point3f physics:localPos0 = (0.45, 0, 0.83)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -40.107044
            float physics:upperLimit = 40.107044
            custom float urdf:limit:effort = 100
        }

        def PhysicsFixedJoint "root_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </hinged_platform>
            custom rel physics:body1
            append rel physics:body1 = </hinged_platform/Geometry/stand>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

