#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "hinged_platform"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "hinged_platform"
{
    over "Geometry"
    {
        over "stand" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI", "NewtonMassAPI"]
        )
        {
            double[] newton:inertia = [0.01, 0.01, 0.01, 0, 0, 0]
            bool newton:selfCollisionEnabled = 0
            float3 physics:diagonalInertia = (0.01, 0.01, 0.01)
            float physics:mass = 5
            quatf physics:principalAxes = (1, 0, 0, 0)

            over "platform" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.005392, 0.000506, 0.005852, 0, 0, 0]
                point3f physics:centerOfMass = (0, -0.006, -0.0112)
                float3 physics:diagonalInertia = (0.000506, 0.005392, 0.005852)
                float physics:mass = 0.5996
                quatf physics:principalAxes = (6.123234e-17, 0.70710677, 0.70710677, 0)

                over "box_16" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }

                over "box_17" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }

