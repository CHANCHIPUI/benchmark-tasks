#usda 1.0
(
    defaultPrim = "gel"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "gel" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.024

    def "Looks"
    {
        def Material "agarose"
        {
            token outputs:surface.connect = </gel/Looks/agarose/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.88, 0.84)
                float inputs:metallic = 0
                float inputs:opacity = 0.8
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "well"
        {
            token outputs:surface.connect = </gel/Looks/well/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.32, 0.34)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cube "slab_back" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </gel/Looks/agarose>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.00675, 0.07, 0.005)
        double3 xformOp:translate = (-0.031625, 0, 0.0025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "slab_front" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
