        double size = 1
        float3 xformOp:scale = (0.092, 0.0008, 0.01)
        double3 xformOp:translate = (0, 0.1279, 0.049)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "anode_assembly" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </tank/Looks/red>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.04, 0.008, 0.014)
        double3 xformOp:translate = (0, -0.1205, 0.053)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "anode_post" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </tank/Looks/red>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.008, 0.006, 0.041)
        double3 xformOp:translate = (0.013999999999999999, -0.1215, 0.0255)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "anode_plug" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.026399999999999996
        rel material:binding = </tank/Looks/gold>
        double radius = 0.002
        double3 xformOp:translate = (0.014, -0.1235, 0.0732)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "anode_collar" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.006
        rel material:binding = </tank/Looks/red>
        double radius = 0.004
        double3 xformOp:translate = (0.014, -0.1235, 0.063)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "anode_band" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </tank/Looks/red>
        double size = 1
        float3 xformOp:scale = (0.092, 0.0008, 0.01)
        double3 xformOp:translate = (0, -0.1279, 0.049)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

