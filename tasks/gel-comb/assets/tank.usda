#usda 1.0
(
    defaultPrim = "tank"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "tank" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1

    def "Looks"
    {
        def Material "clear"
        {
            token outputs:surface.connect = </tank/Looks/clear/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.86, 0.9)
                float inputs:metallic = 0
                float inputs:opacity = 0.45
                float inputs:roughness = 0.15
                token outputs:surface
            }
        }

        def Material "stage"
        {
            token outputs:surface.connect = </tank/Looks/stage/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.89, 0.91)
                float inputs:metallic = 0
                float inputs:opacity = 0.8
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "black"
        {
            token outputs:surface.connect = </tank/Looks/black/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.07)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "red"
        {
            token outputs:surface.connect = </tank/Looks/red/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.08, 0.08)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "gold"
        {
            token outputs:surface.connect = </tank/Looks/gold/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.83, 0.69, 0.3)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }
    }

    def Cube "floor" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </tank/Looks/clear>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.092, 0.255, 0.005)
        double3 xformOp:translate = (0, 0, 0.0025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "side_n" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </tank/Looks/clear>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.003, 0.255, 0.056)
        double3 xformOp:translate = (-0.0445, 0, 0.028)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "side_f" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </tank/Looks/clear>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.003, 0.255, 0.056)
        double3 xformOp:translate = (0.0445, 0, 0.028)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "end_m" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </tank/Looks/clear>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.092, 0.003, 0.056)
        double3 xformOp:translate = (0, -0.126, 0.028)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "end_p" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </tank/Looks/clear>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.092, 0.003, 0.056)
        double3 xformOp:translate = (0, 0.126, 0.028)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "stage" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </tank/Looks/stage>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.086, 0.072, 0.026)
        double3 xformOp:translate = (0, 0, 0.018)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "cathode_assembly" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </tank/Looks/black>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.04, 0.008, 0.014)
        double3 xformOp:translate = (0, 0.1205, 0.053)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "cathode_post" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </tank/Looks/black>
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.008, 0.006, 0.041)
        double3 xformOp:translate = (0.013999999999999999, 0.1215, 0.0255)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "cathode_plug" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.026399999999999996
        rel material:binding = </tank/Looks/gold>
        double radius = 0.002
        double3 xformOp:translate = (0.014, 0.1235, 0.0732)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "cathode_collar" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
