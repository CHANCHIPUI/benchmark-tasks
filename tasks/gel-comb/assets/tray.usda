#usda 1.0
(
    defaultPrim = "tray"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "tray" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0

    def "Looks"
    {
        def Material "acrylic"
        {
            token outputs:surface.connect = </tray/Looks/acrylic/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.84, 0.92)
                float inputs:metallic = 0
                float inputs:opacity = 0.55
                float inputs:roughness = 0.1
                token outputs:surface
            }
        }

        def Material "slick" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0
            float physics:restitution = 0
            float physics:staticFriction = 0
            custom token physxMaterial:frictionCombineMode = "min"
        }
    }

    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.03

        def Cube "floor" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/acrylic>
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.07, 0.07, 0.003)
            double3 xformOp:translate = (0, 0, 0.0015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "wall_l0" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/acrylic>
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.005, 0.004, 0.013)
            double3 xformOp:translate = (-0.0325, 0.037000000000000005, 0.0065)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "wall_l1" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/acrylic>
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.006, 0.004, 0.01)
            double3 xformOp:translate = (-0.027, 0.037000000000000005, 0.004999999999999999)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "wall_l2" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/acrylic>
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.048, 0.004, 0.013)
            double3 xformOp:translate = (0, 0.037000000000000005, 0.0065)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "wall_l3" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/acrylic>
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.006, 0.004, 0.01)
            double3 xformOp:translate = (0.027, 0.037000000000000005, 0.004999999999999999)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "wall_l4" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/acrylic>
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.005, 0.004, 0.013)
            double3 xformOp:translate = (0.0325, 0.037000000000000005, 0.0065)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "wall_r0" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/acrylic>
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.005, 0.004, 0.013)
            double3 xformOp:translate = (-0.0325, -0.037000000000000005, 0.0065)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "wall_r1" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/acrylic>
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.006, 0.004, 0.01)
            double3 xformOp:translate = (-0.027, -0.037000000000000005, 0.004999999999999999)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "wall_r2" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/acrylic>
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.048, 0.004, 0.013)
            double3 xformOp:translate = (0, -0.037000000000000005, 0.0065)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "wall_r3" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/acrylic>
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.006, 0.004, 0.01)
            double3 xformOp:translate = (0.027, -0.037000000000000005, 0.004999999999999999)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "wall_r4" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </tray/Looks/acrylic>
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.005, 0.004, 0.013)
            double3 xformOp:translate = (0.0325, -0.037000000000000005, 0.0065)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "catch" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.0005
        double3 xformOp:translate = (-0.027, 0, 0.031599999999999996)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "end_l" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </tray/Looks/slick> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
            float3 xformOp:scale = (0.014, 0.0022, 0.003)
            double3 xformOp:translate = (0, 0.0362, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "end_r" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </tray/Looks/slick> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float physxCollision:contactOffset = 0.001
            custom float physxCollision:restOffset = 0
            uniform token purpose = "guide"
            double size = 1
            float3 xformOp:scale = (0.014, 0.0022, 0.003)
            double3 xformOp:translate = (0, -0.0362, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def "joints"
    {
        def PhysicsPrismaticJoint "hold" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 10
            float drive:linear:physics:stiffness = 40000
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "Z"
            rel physics:body0 = </tray/base>
            rel physics:body1 = </tray/catch>
            point3f physics:localPos0 = (-0.027, 0, 0.0316)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -0.0281
            float physics:upperLimit = 0.05
        }
    }
}

