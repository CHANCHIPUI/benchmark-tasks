    def Scope "Looks"
    {
        def Material "board"
        {
            token outputs:surface.connect = </Bench/Looks/board/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor.connect = </Bench/Looks/board/color_tex.outputs:rgb>
                float inputs:roughness = 0.85
                token outputs:surface
            }
            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "color_tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/board.png@
                float2 inputs:st.connect = </Bench/Looks/board/uv.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float4 inputs:scale = (1.0, 1.0, 1.0, 1)
                float3 outputs:rgb
            }
        }
        def Material "pine"
        {
            token outputs:surface.connect = </Bench/Looks/pine/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor.connect = </Bench/Looks/pine/color_tex.outputs:rgb>
                float inputs:roughness = 0.7
                token outputs:surface
            }
            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "color_tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/pine.png@
                float2 inputs:st.connect = </Bench/Looks/pine/uv.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float4 inputs:scale = (1.0, 1.0, 1.0, 1)
                float3 outputs:rgb
            }
        }
        def Material "pulp"
        {
            token outputs:surface.connect = </Bench/Looks/pulp/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor.connect = </Bench/Looks/pulp/color_tex.outputs:rgb>
                float inputs:roughness = 0.95
                token outputs:surface
            }
            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "color_tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/pulp.png@
                float2 inputs:st.connect = </Bench/Looks/pulp/uv.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float4 inputs:scale = (1.0, 1.0, 1.0, 1)
                float3 outputs:rgb
            }
        }
    }

