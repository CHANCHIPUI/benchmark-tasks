            }
        }

        def Material "ring"
        {
            token outputs:surface.connect = </timer/Looks/ring/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </timer/Looks/ring/texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/dial_ring.png@
                float2 inputs:st.connect = </timer/Looks/ring/st.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "cap"
        {
            token outputs:surface.connect = </timer/Looks/cap/surface.outputs:surface>

