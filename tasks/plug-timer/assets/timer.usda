#usda 1.0
(
    defaultPrim = "timer"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "timer"
{
    def "Looks"
    {
        def Material "white"
        {
            token outputs:surface.connect = </timer/Looks/white/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.92, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "strip"
        {
            token outputs:surface.connect = </timer/Looks/strip/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
