#usda 1.0
(
    defaultPrim = "head"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "head" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxContactReportAPI"]
)
