#usda 1.0
(
    defaultPrim = "stick"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "stick" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 0

    def "Looks"
    {
        def Material "tube"
        {
            token outputs:surface.connect = </stick/Looks/tube/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.12, 0.18)
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "balm"
        {
            token outputs:surface.connect = </stick/Looks/balm/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.08, 0.14)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

