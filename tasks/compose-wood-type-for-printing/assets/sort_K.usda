#usda 1.0
(
    defaultPrim = "Sort_K"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Sort_K" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 0.0600
    int physxRigidBody:solverPositionIterationCount = 32
    int physxRigidBody:solverVelocityIterationCount = 4
    float physxRigidBody:maxDepenetrationVelocity = 1

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 0.6000
        float physics:dynamicFriction = 0.5000
        float physics:restitution = 0
    }

    def Cube "col_sort" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Sort_K/PhysicsMaterial>
        uniform token purpose = "guide"
        double size = 1
        float physxCollision:contactOffset = 0.004
        float physxCollision:restOffset = 0
        double3 xformOp:translate = (0.000000, 0.000000, 0.000000)
        float3 xformOp:scale = (0.076200, 0.047000, 0.023300)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Scope "Looks"
    {
        def Material "face"
        {
            token outputs:surface.connect = </Sort_K/Looks/face/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor.connect = </Sort_K/Looks/face/color_tex.outputs:rgb>
                float inputs:roughness = 0.5
                token outputs:surface
            }
            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "color_tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/face_K.png@
                float2 inputs:st.connect = </Sort_K/Looks/face/uv.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float4 inputs:scale = (1, 1, 1, 1)
                float3 outputs:rgb
            }
        }
        def Material "side"
        {
            token outputs:surface.connect = </Sort_K/Looks/side/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor.connect = </Sort_K/Looks/side/color_tex.outputs:rgb>
                float inputs:roughness = 0.62
                token outputs:surface
            }
            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "color_tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/maple_side.jpg@
                float2 inputs:st.connect = </Sort_K/Looks/side/uv.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float4 inputs:scale = (1, 1, 1, 1)
                float3 outputs:rgb
            }
        }
    }

    def Xform "visual"
