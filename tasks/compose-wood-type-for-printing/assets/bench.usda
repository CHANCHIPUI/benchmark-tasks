    def Scope "Looks"
    {
        def Material "furniture"
        {
            token outputs:surface.connect = </Bench/Looks/furniture/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor.connect = </Bench/Looks/furniture/color_tex.outputs:rgb>
                float inputs:roughness = 0.65
                token outputs:surface
            }
            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "color_tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/furniture.jpg@
                float2 inputs:st.connect = </Bench/Looks/furniture/uv.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float4 inputs:scale = (1, 1, 1, 1)
                float3 outputs:rgb
            }
        }
        def Material "iron"
        {
            token outputs:surface.connect = </Bench/Looks/iron/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.55
                color3f inputs:diffuseColor = (0.045, 0.046, 0.05)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
        def Material "rubber"
        {
            token outputs:surface.connect = </Bench/Looks/rubber/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.022, 0.023, 0.025)
                float inputs:roughness = 0.92
                token outputs:surface
            }
        }
        def Material "steel"
        {
            token outputs:surface.connect = </Bench/Looks/steel/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.85
                color3f inputs:diffuseColor = (0.3, 0.31, 0.33)
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }
    }

