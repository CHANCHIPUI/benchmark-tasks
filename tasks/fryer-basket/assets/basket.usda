#usda 1.0
(
    defaultPrim = "basket"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "basket" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.4

    def "Looks"
    {
        def Material "chrome"
        {
            token outputs:surface.connect = </basket/Looks/chrome/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.81, 0.83)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "coating"
        {
            token outputs:surface.connect = </basket/Looks/coating/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.06, 0.07)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cube "c_floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token purpose = "guide"
        double size = 1
        float3 xformOp:scale = (0.241, 0.184, 0.002)
        double3 xformOp:translate = (0, 0, 0.001)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

