#usda 1.0
(
    defaultPrim = "fryer"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "fryer" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    def "Looks"
    {
        def Material "steel"
        {
            token outputs:surface.connect = </fryer/Looks/steel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.64, 0.66)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "steel_dark"
        {
            token outputs:surface.connect = </fryer/Looks/steel_dark/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.36, 0.38)
                float inputs:metallic = 0.4
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "panel"
        {
            token outputs:surface.connect = </fryer/Looks/panel/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.1, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "knob"
        {
            token outputs:surface.connect = </fryer/Looks/knob/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.09)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "oil"
        {
            token outputs:surface.connect = </fryer/Looks/oil/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.24, 0.05)
                float inputs:metallic = 0
                float inputs:roughness = 0.15
                token outputs:surface
            }
        }
    }

    def Cube "cabinet" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
    )
    {
        rel material:binding = </fryer/Looks/steel>
        double size = 1
        float3 xformOp:scale = (0.4, 0.267, 0.018)
        double3 xformOp:translate = (0.2, 0, 0.029000000000000005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "foot_0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.02
        rel material:binding = </fryer/Looks/knob>
        double radius = 0.012
        double3 xformOp:translate = (0.03, 0.10350000000000001, 0.01)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "foot_1" (
