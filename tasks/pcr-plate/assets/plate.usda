#usda 1.0
(
    defaultPrim = "plate"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "plate" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.025

    def "Looks"
    {
        def Material "pp"
        {
            token outputs:surface.connect = </plate/Looks/pp/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.91, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "caps"
        {
            token outputs:surface.connect = </plate/Looks/caps/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.86, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "mark"
        {
            token outputs:surface.connect = </plate/Looks/mark/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Cube "c_deck" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        custom float physxCollision:contactOffset = 0.001
        custom float physxCollision:restOffset = 0
        uniform token purpose = "guide"
        double size = 1
        float3 xformOp:scale = (0.0855, 0.1278, 0.0012)
