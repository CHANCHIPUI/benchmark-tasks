#usda 1.0
(
    defaultPrim = "PouchBox"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PouchBox" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 0.3000
    int physxRigidBody:solverPositionIterationCount = 32
    int physxRigidBody:solverVelocityIterationCount = 4
    float physxRigidBody:maxDepenetrationVelocity = 1

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 0.5000
        float physics:dynamicFriction = 0.4500
        float physics:restitution = 0
    }

    def Cube "col_box" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </PouchBox/PhysicsMaterial>
        uniform token purpose = "guide"
        double size = 1
        float physxCollision:contactOffset = 0.004
        float physxCollision:restOffset = 0
        double3 xformOp:translate = (0.000000, 0.000000, 0.000000)
        float3 xformOp:scale = (0.110000, 0.080000, 0.032000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Scope "Looks"
    {
        def Material "band"
        {
            token outputs:surface.connect = </PouchBox/Looks/band/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.84, 0.87, 0.9)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
        def Material "card"
        {
            token outputs:surface.connect = </PouchBox/Looks/card/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.013, 0.05, 0.2)
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }
        def Material "lid"
        {
            token outputs:surface.connect = </PouchBox/Looks/lid/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor.connect = </PouchBox/Looks/lid/color_tex.outputs:rgb>
                float inputs:roughness = 0.7
                token outputs:surface
            }
            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "color_tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/box_top.png@
                float2 inputs:st.connect = </PouchBox/Looks/lid/uv.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float4 inputs:scale = (1, 1, 1, 1)
                float3 outputs:rgb
            }
        }
    }

    def Xform "visual"
    {
        def Mesh "body" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </PouchBox/Looks/card>
            uniform bool doubleSided = 0
