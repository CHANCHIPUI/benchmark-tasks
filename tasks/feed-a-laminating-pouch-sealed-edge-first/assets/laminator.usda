        float3 xformOp:scale = (0.340000, 0.104000, 0.027000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "col_end_l" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Laminator/PhysicsMaterial>
        uniform token purpose = "guide"
        double size = 1
        float physxCollision:contactOffset = 0.004
        float physxCollision:restOffset = 0
        double3 xformOp:translate = (0.206250, -0.015000, 0.039000)
        float3 xformOp:scale = (0.052500, 0.110000, 0.008000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "col_end_r" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Laminator/PhysicsMaterial>
        uniform token purpose = "guide"
        double size = 1
        float physxCollision:contactOffset = 0.004
        float physxCollision:restOffset = 0
        double3 xformOp:translate = (0.493750, -0.015000, 0.039000)
        float3 xformOp:scale = (0.052500, 0.110000, 0.008000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Mesh "col_lip_low" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Laminator/PhysicsMaterial>
        uniform token purpose = "guide"
        uniform token physics:approximation = "convexHull"
        float physxCollision:contactOffset = 0.004
        float physxCollision:restOffset = 0
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [0, 1, 2, 0, 1, 3, 0, 4, 1, 0, 5, 1, 0, 3, 2, 0, 2, 4, 0, 2, 6, 0, 4, 5, 0, 6, 4, 1, 3, 2, 1, 5, 3, 1, 7, 3, 1, 4, 5, 1, 5, 7, 2, 3, 6, 2, 3, 7, 2, 6, 4, 2, 7, 6, 3, 5, 7, 3, 7, 6, 4, 6, 5, 4, 7, 5, 4, 6, 7, 5, 6, 7]
        point3f[] points = [(0.180000, -0.064000, 0.000000), (0.180000, -0.070000, 0.000000), (0.180000, -0.064000, 0.035000), (0.180000, -0.070000, 0.033000), (0.520000, -0.064000, 0.000000), (0.520000, -0.070000, 0.000000), (0.520000, -0.064000, 0.035000), (0.520000, -0.070000, 0.033000)]
    }
    def Mesh "col_lip_high" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Laminator/PhysicsMaterial>
        uniform token purpose = "guide"
        uniform token physics:approximation = "convexHull"
        float physxCollision:contactOffset = 0.004
        float physxCollision:restOffset = 0
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [0, 2, 1, 0, 3, 1, 0, 1, 4, 0, 1, 5, 0, 2, 3, 0, 4, 2, 0, 6, 2, 0, 5, 4, 0, 4, 6, 1, 2, 3, 1, 3, 5, 1, 3, 7, 1, 5, 4, 1, 7, 5, 2, 6, 3, 2, 7, 3, 2, 4, 6, 2, 6, 7, 3, 7, 5, 3, 6, 7, 4, 5, 6, 4, 5, 7, 4, 7, 6, 5, 7, 6]
        point3f[] points = [(0.180000, -0.064000, 0.070000), (0.180000, -0.070000, 0.070000), (0.180000, -0.064000, 0.043000), (0.180000, -0.070000, 0.045000), (0.520000, -0.064000, 0.070000), (0.520000, -0.070000, 0.070000), (0.520000, -0.064000, 0.043000), (0.520000, -0.070000, 0.045000)]
    }

    def Scope "Looks"
    {
        def Material "bezel"
        {
            token outputs:surface.connect = </Laminator/Looks/bezel/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.11, 0.115, 0.12)
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
        def Material "foot"
        {
            token outputs:surface.connect = </Laminator/Looks/foot/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.03, 0.03, 0.03)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
        def Material "housing"
        {
            token outputs:surface.connect = </Laminator/Looks/housing/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor.connect = </Laminator/Looks/housing/color_tex.outputs:rgb>
                float inputs:roughness = 0.45
                token outputs:surface
            }
            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "color_tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/plastic.png@
                float2 inputs:st.connect = </Laminator/Looks/housing/uv.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float4 inputs:scale = (0.5, 0.51, 0.52, 1)
                float3 outputs:rgb
            }
        }
        def Material "inside"
        {
            token outputs:surface.connect = </Laminator/Looks/inside/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.012, 0.012, 0.012)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
        def Material "lamp"
        {
            token outputs:surface.connect = </Laminator/Looks/lamp/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.05, 0.6, 0.12)
                float inputs:roughness = 0.3
                color3f inputs:emissiveColor = (0.1, 2.2, 0.35)
                token outputs:surface
            }
        }
        def Material "mark"
        {
            token outputs:surface.connect = </Laminator/Looks/mark/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.85, 0.86, 0.87)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
        def Material "panel"
        {
            token outputs:surface.connect = </Laminator/Looks/panel/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.055, 0.058, 0.064)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
        def Material "roller"
        {
            token outputs:surface.connect = </Laminator/Looks/roller/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.02, 0.02, 0.02)
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }
        def Material "top_panel"
        {
            token outputs:surface.connect = </Laminator/Looks/top_panel/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor.connect = </Laminator/Looks/top_panel/color_tex.outputs:rgb>
                float inputs:roughness = 0.4
                token outputs:surface
            }
            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "color_tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/plastic.png@
                float2 inputs:st.connect = </Laminator/Looks/top_panel/uv.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float4 inputs:scale = (0.075, 0.08, 0.09, 1)
                float3 outputs:rgb
            }
        }
    }

