#usda 1.0
(
    defaultPrim = "Pouch"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Pouch" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 0.0080
    int physxRigidBody:solverPositionIterationCount = 32
    int physxRigidBody:solverVelocityIterationCount = 4
    float physxRigidBody:maxDepenetrationVelocity = 1

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 0.4500
        float physics:dynamicFriction = 0.4000
        float physics:restitution = 0
    }

    def Cube "col_pouch" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Pouch/PhysicsMaterial>
        uniform token purpose = "guide"
        double size = 1
        float physxCollision:contactOffset = 0.004
        float physxCollision:restOffset = 0
        double3 xformOp:translate = (0.000000, 0.000000, 0.000000)
        float3 xformOp:scale = (0.075000, 0.105000, 0.002500)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Scope "Looks"
    {
        def Material "card"
        {
            token outputs:surface.connect = </Pouch/Looks/card/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor.connect = </Pouch/Looks/card/color_tex.outputs:rgb>
                float inputs:roughness = 0.55
                token outputs:surface
            }
            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "color_tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/card.png@
                float2 inputs:st.connect = </Pouch/Looks/card/uv.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float4 inputs:scale = (1, 1, 1, 1)
                float3 outputs:rgb
            }
        }
        def Material "card_edge"
        {
            token outputs:surface.connect = </Pouch/Looks/card_edge/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.92, 0.92, 0.9)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
        def Material "film"
        {
            token outputs:surface.connect = </Pouch/Looks/film/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.55, 0.6, 0.62)
                float inputs:roughness = 0.04
                float inputs:opacity = 0.1
                token outputs:surface
            }
        }
        def Material "film_edge"
        {
            token outputs:surface.connect = </Pouch/Looks/film_edge/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.85, 0.9, 0.93)
                float inputs:roughness = 0.1
                float inputs:opacity = 0.6
                token outputs:surface
            }
        }
        def Material "seal"
        {
            token outputs:surface.connect = </Pouch/Looks/seal/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.95, 0.96, 0.97)
                float inputs:roughness = 0.65
                float inputs:opacity = 0.93
                token outputs:surface
            }
        }
    }

