    def Cube "grip" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </OverflowPlug/PhysicsMaterial>
        uniform token purpose = "guide"
        double size = 1
        float physxCollision:contactOffset = 0.0005
        float physxCollision:restOffset = 0
        double3 xformOp:translate = (0.000000, -0.014000, 0.018000)
        float3 xformOp:scale = (0.022000, 0.007000, 0.016000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Scope "Looks"
    {
        def Material "chrome"
        {
            token outputs:surface.connect = </OverflowPlug/Looks/chrome/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.93
                color3f inputs:diffuseColor = (0.65, 0.68, 0.7)
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }
        def Material "rubber"
        {
            token outputs:surface.connect = </OverflowPlug/Looks/rubber/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.08, 0.23, 0.31)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

