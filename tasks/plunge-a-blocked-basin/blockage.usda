#usda 1.0
(defaultPrim="Blockage"
 metersPerUnit=1
 upAxis="Z")
def Xform "Blockage" {
def Scope "Looks" {
        def Material "ceramic"
        {
            token outputs:surface.connect = </Blockage/Looks/ceramic/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.93, 0.95, 0.94)
                float inputs:roughness = 0.13
                token outputs:surface
            }

        }

        def Material "rubber"
        {
            token outputs:surface.connect = </Blockage/Looks/rubber/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.08, 0.23, 0.31)
                float inputs:roughness = 0.6
                token outputs:surface
            }

        }

        def Material "red"
        {
            token outputs:surface.connect = </Blockage/Looks/red/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.72, 0.12, 0.07)
                float inputs:roughness = 0.4
                token outputs:surface
            }

        }

        def Material "chrome"
        {
            token outputs:surface.connect = </Blockage/Looks/chrome/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.93
                color3f inputs:diffuseColor = (0.65, 0.68, 0.7)
                float inputs:roughness = 0.2
                token outputs:surface
            }

        }

        def Material "water"
        {
            token outputs:surface.connect = </Blockage/Looks/water/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.28, 0.68, 0.79)
                float inputs:roughness = 0.12
                float inputs:opacity = 0.48
                token outputs:surface
            }

        }

        def Material "glass"
        {
            token outputs:surface.connect = </Blockage/Looks/glass/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.76, 0.89, 0.91)
                float inputs:roughness = 0.18
                float inputs:opacity = 0.2
                token outputs:surface
            }

        }

        def Material "pipe"
        {
            token outputs:surface.connect = </Blockage/Looks/pipe/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.84, 0.84, 0.82)
                float inputs:roughness = 0.5
                token outputs:surface
            }

        }

        def Material "dark"
        {
            token outputs:surface.connect = </Blockage/Looks/dark/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.08, 0.07, 0.06)
                float inputs:roughness = 0.9
                token outputs:surface
            }

        }

        def Material "mat"
        {
            token outputs:surface.connect = </Blockage/Looks/mat/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:metallic = 0.0
                color3f inputs:diffuseColor = (0.17, 0.23, 0.25)
                float inputs:roughness = 0.9
                token outputs:surface
            }

        }

}

def Xform "base" (prepend apiSchemas=["PhysicsRigidBodyAPI","PhysicsMassAPI","PhysxRigidBodyAPI","PhysicsArticulationRootAPI","PhysxArticulationAPI"]) {
 float physics:mass=0.1
 float3 physics:diagonalInertia=(0.0001,0.0001,0.0001)
 float physxRigidBody:maxDepenetrationVelocity=1
 float physxRigidBody:sleepThreshold=0
 bool physxArticulation:enabledSelfCollisions=0
int physxArticulation:solverPositionIterationCount=64
int physxArticulation:solverVelocityIterationCount=16
 
 def Xform "visual" {}

 }

def Xform "plug" (prepend apiSchemas=["PhysicsRigidBodyAPI","PhysicsMassAPI","PhysxRigidBodyAPI"]) {
 float physics:mass=0.006
 float3 physics:diagonalInertia=(6e-06,6e-06,6e-06)
 float physxRigidBody:maxDepenetrationVelocity=1
 float physxRigidBody:sleepThreshold=0
 
 
